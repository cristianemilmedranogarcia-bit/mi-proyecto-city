    <script>
        const seasonalCollapsed = document.getElementById('seasonal-collapsed');
        const seasonalExpanded = document.getElementById('seasonal-expanded');
        const seasonalHeading = document.getElementById('seasonal-heading');
        const seasonalOpen = document.getElementById('seasonal-open');
        const seasonalClose = document.getElementById('seasonal-close');

        seasonalOpen?.addEventListener('click', () => {
            seasonalCollapsed?.classList.add('closed');
            seasonalExpanded?.classList.add('open');
            seasonalHeading?.classList.add('hidden');
        });

        seasonalClose?.addEventListener('click', () => {
            seasonalExpanded?.classList.remove('open');
            seasonalCollapsed?.classList.remove('closed');
            seasonalHeading?.classList.remove('hidden');
        });
    </script>

