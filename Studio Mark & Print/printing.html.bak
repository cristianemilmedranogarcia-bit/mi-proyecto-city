<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Studio Mark & Print | Premium Printing</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
        href="https://fonts.googleapis.com/css2?family=Noto+Serif:wght@400;700;900&family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet" />
    <style>
        body {
            background: #f8f9fa;
            color: #111111;
            font-family: "Inter", sans-serif;
        }

        .printing-topbar {
            background: #f4f1eb;
            border-bottom: 1px solid #ece7df;
            color: #3f3a34;
            font-size: 0.82rem;
            line-height: 1.2;
            text-align: center;
            padding: 0.7rem 1.5rem;
            letter-spacing: 0.01em;
        }

        .printing-header {
            background: #ffffff;
            border-bottom: 1px solid #ece9e5;
        }

        .printing-header-top {
            max-width: 96rem;
            margin: 0 auto;
            padding: 1.25rem 2rem;
            display: grid;
            grid-template-columns: auto 1fr auto;
            align-items: center;
            gap: 3rem;
        }

        .printing-header-bottom {
            background: #ffffff;
            border-top: 1px solid #f2f0ed;
        }

        .printing-header-inner {
            max-width: 96rem;
            margin: 0 auto;
            padding: 0.85rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .printing-logo {
            text-decoration: none;
            font-size: 1.55rem;
            font-weight: 800;
            letter-spacing: -0.05em;
            color: #0e3b2e;
            line-height: 1;
        }

        .printing-nav {
            display: flex;
            align-items: center;
            gap: 1.75rem;
            font-size: 0.95rem;
            color: #211f1b;
        }

        .printing-nav a {
            position: relative;
        }

        .printing-nav a::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: -0.3rem;
            width: 100%;
            height: 1px;
            background: currentColor;
            opacity: 0;
            transform: scaleX(0.4);
            transform-origin: center;
            transition: opacity 0.2s ease, transform 0.2s ease;
        }

        .printing-nav a:hover::after {
            opacity: 1;
            transform: scaleX(1);
        }

        .header-search-container {
            position: relative;
            max-width: 42rem;
            width: 100%;
        }

        .header-search-input {
            width: 100%;
            height: 2.85rem;
            background: #f8f7f5 !important;
            border: 1px solid #e5e0d8 !important;
            border-radius: 999px !important;
            padding: 0 1.5rem 0 3.25rem !important;
            font-size: 0.92rem !important;
            color: #171717;
            transition: all 0.2s ease;
            box-shadow: none !important;
            display: block !important;
            line-height: 2.85rem !important;
        }

        .header-search-input:focus {
            outline: none !important;
            border-color: #0e3b2e !important;
            background: #ffffff !important;
            box-shadow: 0 0 0 3px rgba(14, 59, 46, 0.08) !important;
        }

        .search-icon {
            position: absolute;
            left: 1.25rem;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(20, 20, 20, 0.45);
            pointer-events: none;
            z-index: 20;
            display: block !important;
        }

        .header-utilities {
            display: flex;
            align-items: center;
            gap: 1.75rem;
        }

        .utility-btn {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            text-decoration: none;
            color: #211f1b;
            font-size: 0.92rem;
            font-weight: 600;
            transition: opacity 0.2s ease;
        }

        .utility-btn:hover {
            opacity: 0.7;
        }

        .utility-icon {
            width: 1.35rem;
            height: 1.35rem;
            stroke-width: 1.8;
        }

        .cart-btn {
            position: relative;
        }

        .cart-count {
            position: absolute;
            top: -0.45rem;
            right: -1.1rem;
            background: #0e3b2e;
            color: #ffffff;
            font-size: 0.65rem;
            font-weight: 800;
            min-width: 1.15rem;
            height: 1.15rem;
            border-radius: 999px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #ffffff;
        }

        .printing-nav-meta {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            color: #5d5851;
            font-size: 0.88rem;
        }

        .printing-nav-meta a {
            text-decoration: none;
            font-weight: 600;
        }

        .printing-hero {
            display: grid;
            grid-template-columns: minmax(0, 0.98fr) minmax(0, 1.02fr);
            overflow: hidden;
            background: #ffffff;
            border-bottom: 1px solid #ece9e5;
            min-height: 236px;
        }

        .printing-hero-copy {
            background: #765066;
            color: #ffffff;
            padding: 2.5rem 2.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            min-height: 236px;
        }

        .printing-hero-title {
            font-size: clamp(2.1rem, 4.4vw, 3.75rem);
            line-height: 0.92;
            letter-spacing: -0.06em;
            font-weight: 500;
            max-width: 20rem;
        }

        .printing-hero-text {
            margin-top: 1rem;
            font-size: 0.88rem;
            line-height: 1.45;
            color: rgba(255, 255, 255, 0.84);
            max-width: 19rem;
        }

        .printing-hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-top: 1.35rem;
        }

        .printing-hero-primary,
        .printing-hero-secondary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 2.9rem;
            padding: 0 1.3rem;
            border-radius: 0.35rem;
            font-size: 0.9rem;
            font-weight: 600;
            transition: transform 0.25s ease, opacity 0.25s ease, background-color 0.25s ease;
        }

        .printing-hero-primary {
            background: #ffffff;
            color: #141414;
        }

        .printing-hero-secondary {
            background: #143422;
            color: #ffffff;
        }

        .printing-hero-primary:hover,
        .printing-hero-secondary:hover {
            transform: translateY(-2px);
        }

        .printing-hero-visual {
            position: relative;
            min-height: 236px;
            background: #e0c59e;
            overflow: hidden;
        }

        .printing-hero-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .service-line-arrow {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 3.25rem;
            height: 3.25rem;
            border-radius: 9999px;
            background: rgba(255, 255, 255, 0.94);
            box-shadow: 0 10px 24px rgba(15, 23, 42, 0.1);
            backdrop-filter: blur(8px);
            border: 0;
            padding: 0;
            color: #111111;
            transition: transform 0.25s ease, opacity 0.25s ease;
            pointer-events: auto;
        }

        .service-line-arrow:hover {
            transform: translateY(-2px);
        }

        .service-line-arrow span {
            font-size: 2rem;
            line-height: 1;
        }

        .seasonal-card {
            display: flex;
            flex-direction: column;
            gap: 0.85rem;
        }

        .seasonal-card-link {
            text-decoration: none;
            color: inherit;
            transition: transform 0.22s ease, opacity 0.22s ease;
        }

        .seasonal-card-link:hover {
            transform: translateY(-4px);
        }

        .seasonal-visual {
            aspect-ratio: 1 / 1;
            border-radius: 1.7rem;
            background: #f5f4f2;
            position: relative;
            overflow: hidden;
        }

        .seasonal-pill {
            position: absolute;
            top: 1.25rem;
            left: 1.25rem;
            background: #16845d;
            color: #ffffff;
            border-radius: 9999px;
            padding: 0.45rem 0.85rem;
            font-size: 0.95rem;
            font-weight: 700;
        }

        .seasonal-expanded-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }

        .seasonal-expanded-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 2rem;
        }

        .editorial-footer {
            position: relative;
            overflow: hidden;
            background:
                radial-gradient(circle at top left, rgba(146, 112, 128, 0.16), transparent 30%),
                linear-gradient(180deg, #f7f3ec 0%, #efe8de 100%);
            color: #151515;
        }

        .editorial-footer::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                linear-gradient(120deg, rgba(255, 255, 255, 0.38), transparent 40%),
                linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.035) 100%);
            pointer-events: none;
        }

        .editorial-footer>* {
            position: relative;
            z-index: 1;
        }

        .footer-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.7rem;
            font-size: 0.72rem;
            line-height: 1;
            letter-spacing: 0.32em;
            text-transform: uppercase;
            color: rgba(21, 21, 21, 0.56);
        }

        .footer-badge::before {
            content: "";
            width: 3.5rem;
            height: 1px;
            background: currentColor;
            opacity: 0.7;
        }

        .footer-link-stack a {
            color: rgba(21, 21, 21, 0.68);
            transition: color 0.2s ease, transform 0.2s ease;
        }

        .footer-link-stack a:hover {
            color: #151515;
            transform: translateX(2px);
        }

        .footer-contact-card {
            border: 1px solid rgba(21, 21, 21, 0.08);
            background: rgba(255, 255, 255, 0.52);
            backdrop-filter: blur(10px);
            box-shadow: 0 24px 60px rgba(15, 23, 42, 0.06);
        }

        .seasonal-expanded {
            display: none;
        }

        .seasonal-expanded.open {
            display: block;
        }

        .seasonal-collapsed.closed {
            display: none;
        }

        .seasonal-heading.hidden {
            display: none;
        }

        .seasonal-rail {
            position: relative;
        }

        .seasonal-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 2rem;
        }

        .seasonal-title {
            font-size: 0.95rem;
            line-height: 1.3;
            font-weight: 700;
            color: #111111;
        }

        .seasonal-arrow {
            position: absolute;
            top: 5.9rem;
            width: 3.9rem;
            height: 3.9rem;
            border-radius: 1rem;
            border: 1px solid #dddddd;
            background: rgba(255, 255, 255, 0.96);
            box-shadow: 0 14px 30px rgba(15, 23, 42, 0.08);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #4b5563;
            font-size: 2rem;
        }

        .seasonal-arrow.left {
            left: -2.2rem;
        }

        .seasonal-arrow.right {
            right: -2.2rem;
        }

        .print-editorial-band {
            background: #171717;
            color: #f6f0e6;
            position: relative;
            overflow: hidden;
        }

        .print-editorial-band::before {
            content: "";
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at top right, rgba(118, 80, 102, 0.28), transparent 22%),
                radial-gradient(circle at bottom left, rgba(34, 96, 88, 0.32), transparent 28%);
            pointer-events: none;
        }

        .print-editorial-band>*,
        .print-material-grid>*,
        .print-finish-grid>* {
            position: relative;
            z-index: 1;
        }

        .print-section-kicker {
            display: inline-flex;
            align-items: center;
            gap: 0.7rem;
            font-size: 0.7rem;
            line-height: 1;
            text-transform: uppercase;
            letter-spacing: 0.34em;
            color: rgba(246, 240, 230, 0.62);
        }

        .print-section-kicker::before {
            content: "";
            width: 3rem;
            height: 1px;
            background: currentColor;
            opacity: 0.75;
        }

        .print-material-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
            gap: 2rem;
        }

        .print-card-soft {
            border: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(10px);
        }

        .print-card-light {
            border: 1px solid rgba(21, 21, 21, 0.08);
            background: #ffffff;
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.04);
        }

        .print-chip {
            display: inline-flex;
            align-items: center;
            padding: 0.5rem 0.9rem;
            border-radius: 9999px;
            font-size: 0.78rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            background: rgba(255, 255, 255, 0.08);
            color: rgba(246, 240, 230, 0.88);
        }

        .print-finish-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1.5rem;
        }

        .print-process-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1.5rem;
        }

        .print-process-step {
            border-top: 1px solid rgba(21, 21, 21, 0.12);
            padding-top: 1rem;
        }

        .print-process-step span {
            display: block;
            font-size: 0.75rem;
            letter-spacing: 0.28em;
            text-transform: uppercase;
            color: rgba(21, 21, 21, 0.45);
            margin-bottom: 0.9rem;
        }

        .print-proof-panel {
            background:
                radial-gradient(circle at top left, rgba(118, 80, 102, 0.14), transparent 30%),
                linear-gradient(180deg, #f7f3ec 0%, #f0e8de 100%);
        }

        .print-case-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
            gap: 2rem;
            align-items: stretch;
        }

        .print-case-photo {
            min-height: 36rem;
            overflow: hidden;
            border-radius: 2rem;
            background: #ddd4c7;
        }

        .print-case-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .print-case-copy {
            border-radius: 2rem;
            background: #ffffff;
            border: 1px solid rgba(21, 21, 21, 0.08);
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.04);
            padding: 2.5rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .print-metric-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1rem;
        }

        .print-gallery-grid {
            display: grid;
            grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
            gap: 1.5rem;
        }

        .print-gallery-stack {
            display: grid;
            gap: 1.5rem;
        }

        .print-gallery-card {
            overflow: hidden;
            border-radius: 2rem;
            background: #ece7df;
            position: relative;
        }

        .print-gallery-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .print-gallery-caption {
            position: absolute;
            left: 1.4rem;
            bottom: 1.4rem;
            right: 1.4rem;
            padding: 1rem 1.1rem;
            border-radius: 1.25rem;
            background: rgba(20, 20, 20, 0.72);
            color: #f7f3ec;
            backdrop-filter: blur(10px);
        }

        @media (max-width: 1200px) {
            .seasonal-expanded-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }

            .seasonal-grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }

            .print-material-grid {
                grid-template-columns: 1fr;
            }

            .print-finish-grid {
                grid-template-columns: 1fr 1fr;
            }

            .print-process-grid {
                grid-template-columns: 1fr 1fr;
            }

            .print-case-grid,
            .print-gallery-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 820px) {
            .printing-header-inner {
                padding: 1rem 1.25rem;
                flex-wrap: wrap;
            }

            .printing-nav {
                order: 3;
                width: 100%;
                justify-content: space-between;
                gap: 1rem;
                font-size: 0.82rem;
                overflow-x: auto;
            }

            .printing-hero {
                grid-template-columns: 1fr;
            }

            .printing-hero-copy {
                padding: 2rem 1.25rem;
                min-height: auto;
            }

            .printing-hero-visual {
                min-height: 16rem;
            }

            .seasonal-expanded-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .seasonal-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .print-finish-grid,
            .print-process-grid {
                grid-template-columns: 1fr;
            }

            .print-metric-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 560px) {
            .seasonal-expanded-grid {
                grid-template-columns: minmax(0, 1fr);
            }

            .seasonal-grid {
                grid-template-columns: minmax(0, 1fr);
            }
        }
    </style>
    <link rel="stylesheet" href="print-product.css">
    <style>
        .product-shell-override { min-height: auto; background: transparent; }
        :root {
            --hero-bg: #404B57;
            --hero-fg: #F1F4F7;
            --visual-bg: #E4E8ED;
            --shape-a: #2b7d92;
            --shape-b: #7e5a85;
            --shape-c: #1a1c5e;
            --card-one: #fbfaf6;
            --card-two: #235f73;
            --note-color: #d7c78b;
            --circle-color: #b94f7c;
            --ticket-color: #1d245f;
        }

        .product-hero {
            position: relative;
            min-height: 460px;
        }

        .product-hero-copy {
            position: relative;
            padding-top: 2.2rem;
            padding-bottom: 1.7rem;
            padding-left: 2.2rem;
        }

        .product-title {
            font-size: clamp(2.9rem, 4.95vw, 4.75rem);
            line-height: 0.92;
        }

        .product-copy {
            font-size: 1rem;
            line-height: 1.5;
            max-width: 28.5rem;
        }

        .product-hero-visual {
            position: relative;
            min-height: 460px;
        }

        .business-cards-visual {
            position: relative;
            width: min(100%, 27rem);
            margin: 0 auto;
            padding: 1.65rem 0 0;
        }

        .bc-stack {
            position: relative;
            width: 100%;
            height: 20.75rem;
        }

        .bc-card {
            position: absolute;
            width: 18.8rem;
            height: 11rem;
            border-radius: 1.35rem;
            overflow: hidden;
            box-shadow: 0 1.8rem 3.8rem rgba(30, 24, 21, 0.18), 0 0.5rem 1.4rem rgba(30, 24, 21, 0.08);
            cursor: pointer;
            transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.35s ease, z-index 0.2s ease;
        }

        .bc-card::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), transparent 35%, rgba(0, 0, 0, 0.03));
            pointer-events: none;
        }

        .bc-card.dark {
            top: 1.8rem;
            left: 3.2rem;
            transform: rotate(-7deg);
            background: #151515;
            color: #f4efe7;
            padding: 1.8rem 1.8rem 1.35rem;
            z-index: 3;
            animation: bcFloatA 6s ease-in-out infinite alternate;
        }

        .bc-card.light {
            top: 5.9rem;
            left: 4.9rem;
            transform: rotate(3.5deg);
            background: linear-gradient(135deg, #faf4eb 0%, #efe5d7 100%);
            color: #202020;
            border: 1px solid rgba(29, 24, 20, 0.08);
            padding: 1.8rem 1.8rem 1.35rem;
            z-index: 4;
            animation: bcFloatB 7s ease-in-out infinite alternate;
        }

        .bc-card.green {
            top: 9.8rem;
            left: 3.9rem;
            transform: rotate(-1.2deg);
            background: #0f4a37;
            color: #edf5ef;
            padding: 1.65rem 1.75rem 1.25rem;
            z-index: 5;
            animation: bcFloatC 5.5s ease-in-out infinite alternate;
        }

        .bc-card.dark:hover {
            z-index: 10;
            transform: rotate(-4deg) translateY(-1rem) scale(1.03);
        }

        .bc-card.light:hover {
            z-index: 10;
            transform: rotate(1deg) translateY(-1rem) scale(1.03);
        }

        .bc-card.green:hover {
            z-index: 10;
            transform: rotate(0deg) translateY(-1rem) scale(1.03);
        }

        @keyframes bcFloatA {
            from {
                transform: rotate(-7deg) translateY(0);
            }

            to {
                transform: rotate(-7deg) translateY(-0.7rem);
            }
        }

        @keyframes bcFloatB {
            from {
                transform: rotate(3.5deg) translateY(0);
            }

            to {
                transform: rotate(3.5deg) translateY(-0.55rem);
            }
        }

        @keyframes bcFloatC {
            from {
                transform: rotate(-1.2deg) translateY(0);
            }

            to {
                transform: rotate(-1.2deg) translateY(-0.85rem);
            }
        }

        .bc-name {
            font-family: Georgia, "Times New Roman", serif;
            font-size: 1rem;
            line-height: 1;
            letter-spacing: -0.03em;
            font-weight: 700;
        }

        .bc-role {
            margin-top: 0.55rem;
            font-size: 0.72rem;
            letter-spacing: 0.34em;
            text-transform: uppercase;
            opacity: 0.42;
        }

        .bc-dark-line {
            width: 2.2rem;
            height: 0.15rem;
            border-radius: 999px;
            background: linear-gradient(90deg, #d0ae63, #a98039);
            margin: 1rem 0 1.2rem;
        }

        .bc-small {
            font-size: 0.78rem;
            line-height: 1.65;
            opacity: 0.34;
        }

        .bc-mark {
            position: absolute;
            right: 1.25rem;
            top: 1.25rem;
            width: 2.1rem;
            height: 2.1rem;
            border-radius: 0.65rem;
            border: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Georgia, "Times New Roman", serif;
            font-size: 1rem;
            font-weight: 700;
            color: rgba(255, 255, 255, 0.7);
            background: rgba(255, 255, 255, 0.03);
        }

        .bc-edge {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 0.28rem;
            background: linear-gradient(90deg, #0e3b2e, #1f6a4d, #0e3b2e);
        }

        .bc-right-note {
            position: absolute;
            top: 1.55rem;
            right: 1.7rem;
            text-align: right;
            font-size: 0.72rem;
            letter-spacing: 0.22em;
            text-transform: uppercase;
            color: rgba(20, 20, 20, 0.32);
            line-height: 1.35;
        }

        .bc-right-note strong {
            display: block;
            margin-top: 0.15rem;
            font-family: Georgia, "Times New Roman", serif;
            letter-spacing: -0.04em;
            text-transform: none;
            font-size: 0.95rem;
            color: #212121;
        }

        .bc-divider {
            position: absolute;
            left: 1.8rem;
            right: 1.8rem;
            bottom: 3.1rem;
            height: 1px;
            background: rgba(20, 20, 20, 0.1);
        }

        .bc-bottom-left,
        .bc-bottom-right {
            position: absolute;
            bottom: 1.2rem;
            font-size: 0.76rem;
            color: rgba(20, 20, 20, 0.34);
            letter-spacing: 0.1em;
        }

        .bc-bottom-left {
            left: 1.8rem;
        }

        .bc-bottom-right {
            right: 1.8rem;
        }

        .bc-orb {
            position: absolute;
            right: 1.55rem;
            top: 1.55rem;
            width: 2.3rem;
            height: 2.3rem;
            border-radius: 999px;
            border: 1px solid rgba(255, 255, 255, 0.12);
        }

        .bc-orb::after {
            content: "";
            position: absolute;
            inset: 0.52rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.09);
        }

        .bc-green-footer {
            position: absolute;
            left: 1.75rem;
            right: 1.75rem;
            bottom: 1.35rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.78rem;
            color: rgba(237, 245, 239, 0.26);
        }

        .bc-green-list {
            display: grid;
            gap: 0.45rem;
        }

        .bc-green-list span::before {
            content: "";
            display: inline-block;
            width: 0.46rem;
            height: 0.46rem;
            border-radius: 999px;
            background: rgba(237, 245, 239, 0.24);
            margin-right: 0.45rem;
            vertical-align: middle;
        }

        .bc-finish-tabs {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.7rem;
            flex-wrap: wrap;
            margin-top: 0.2rem;
        }

        .bc-finish-chip {
            min-height: 2.7rem;
            padding: 0 1.45rem;
            border-radius: 999px;
            border: 1px solid rgba(255, 255, 255, 0.46);
            background: rgba(255, 255, 255, 0.18);
            color: rgba(255, 255, 255, 0.78);
            font-size: 0.9rem;
            font-weight: 600;
            letter-spacing: -0.02em;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(4px);
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .bc-finish-chip.is-active {
            background: #ffffff;
            color: #1b1b1b;
            border-color: #ffffff;
            box-shadow: 0 0.6rem 1.4rem rgba(35, 24, 18, 0.08);
        }

        .bc-finish-chip:hover {
            background: rgba(255, 255, 255, 0.25);
            color: #ffffff;
        }

        .bc-finish-chip.is-active:hover {
            color: #1b1b1b;
            background: #ffffff;
        }

        .bc-finish-note {
            margin-top: 0.8rem;
            text-align: center;
            font-size: 0.88rem;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.62);
        }

        .sizes-section .section-kicker {
            margin-bottom: 0.9rem;
        }

        .sizes-section .section-title {
            margin-bottom: 2.2rem;
            max-width: 28rem;
            text-wrap: balance;
        }

        .size-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1.25rem;
            margin-top: 0.5rem;
        }

        .size-card {
            background: #fff;
            border: 1px solid #e8e5e1;
            border-radius: 1rem;
            padding: 1.5rem;
            transition: all 0.25s ease;
            position: relative;
        }

        .size-card:hover {
            border-color: #141414;
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
        }

        .size-card.popular {
            border-color: #0e3b2e;
            padding-top: 2rem;
        }

        .size-popular-tag {
            position: absolute;
            top: 0.85rem;
            left: 1rem;
            background: #0e3b2e;
            color: #fff;
            font-size: 0.65rem;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            padding: 0.2rem 0.6rem;
            border-radius: 999px;
            font-weight: 600;
        }

        .size-visual {
            background: #f0ece8;
            border-radius: 0.5rem;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .size-rect {
            background: #d6d0ca;
            border-radius: 3px;
        }

        .size-label {
            font-size: 0.95rem;
            font-weight: 600;
            color: #141414;
        }

        .size-dim {
            font-size: 0.78rem;
            color: #888;
            margin-top: 0.2rem;
        }

        .pricing-section-head {
            text-align: center;
            max-width: 42rem;
            margin: 0 auto 2.8rem;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .pricing-section-head .section-title {
            margin-bottom: 1.1rem;
        }

        .pricing-container {
            max-width: 56rem;
            margin: 0 auto;
        }

        .pricing-copy p {
            margin: 0;
            font-size: 1.05rem;
            line-height: 1.7;
            color: rgba(20, 20, 20, 0.62);
            text-wrap: balance;
        }

        .pricing-panel {
            background: #fff;
            border: 1px solid #ebe6df;
            border-radius: 1.4rem;
            overflow: hidden;
            box-shadow: 0 16px 40px rgba(21, 21, 21, 0.05);
        }

        .pricing-table {
            width: 100%;
            border-collapse: collapse;
        }

        .pricing-table th {
            text-align: left;
            font-size: 0.72rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: #8a8278;
            padding: 1.1rem 1.25rem;
            background: #faf7f2;
            border-bottom: 1px solid #ebe6df;
        }

        .pricing-table td {
            padding: 1.15rem 1.25rem;
            border-bottom: 1px solid #f0ebe4;
            vertical-align: middle;
        }

        .pricing-table tr:last-child td {
            border-bottom: none;
        }

        .pricing-table tr:hover td {
            background: rgba(20, 20, 20, 0.018);
        }

        .pricing-qty {
            font-size: 1rem;
            font-weight: 700;
            color: #151515;
        }

        .pricing-price {
            font-size: 1.15rem;
            font-weight: 700;
            letter-spacing: -0.03em;
            color: #151515;
        }

        .pricing-per {
            font-size: 0.95rem;
            color: rgba(20, 20, 20, 0.64);
        }

        .pricing-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 1.9rem;
            padding: 0 0.75rem;
            border-radius: 999px;
            background: #0e3b2e;
            color: #fff;
            font-size: 0.7rem;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            font-weight: 700;
        }

        .preview-layout {
            display: grid;
            grid-template-columns: 0.82fr 1.18fr;
            gap: 2rem;
            margin-top: 2.5rem;
        }

        .preview-controls {
            background: #ffffff;
            border: 1px solid #ebe6df;
            border-radius: 1.4rem;
            padding: 1.6rem;
            box-shadow: 0 16px 40px rgba(21, 21, 21, 0.05);
            display: grid;
            gap: 0.9rem;
            align-content: start;
        }

        .preview-controls label {
            font-size: 0.78rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: #7b7369;
            font-weight: 700;
        }

        .preview-controls input,
        .preview-controls select {
            width: 100%;
            min-height: 3rem;
            border: 1px solid #ddd6cd;
            border-radius: 0.9rem;
            background: #fbf8f3;
            padding: 0 1rem;
            font-size: 0.98rem;
            color: #171717;
        }

        .preview-controls input[type="color"] {
            padding: 0.35rem;
            min-height: 3.2rem;
        }

        .preview-controls input[type="file"] {
            padding: 0.8rem 1rem;
            background: #fbf8f3;
        }

        .preview-stage {
            background:
                radial-gradient(circle at top left, rgba(155, 112, 131, 0.22), transparent 26%),
                linear-gradient(180deg, #f5efe6 0%, #efe7db 100%);
            border: 1px solid #ebe6df;
            border-radius: 1.7rem;
            min-height: 36rem;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            position: relative;
            overflow: hidden;
        }

        .preview-card {
            width: min(100%, 31rem);
            aspect-ratio: 1.72 / 1;
            border-radius: 1.5rem;
            padding: 1.8rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            box-shadow: 0 2rem 4rem rgba(21, 21, 21, 0.16), 0 0.6rem 1.5rem rgba(21, 21, 21, 0.08);
            background: #171717;
            color: #ffffff;
        }

        .preview-card::before {
            content: "";
            position: absolute;
            inset: 0;
            background: var(--preview-image, none);
            background-size: cover;
            background-position: center;
            opacity: var(--preview-image-opacity, 0);
            mix-blend-mode: multiply;
            pointer-events: none;
        }

        .preview-card::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), transparent 32%, rgba(0, 0, 0, 0.04));
            pointer-events: none;
        }

        .preview-card>* {
            position: relative;
            z-index: 1;
        }

        .preview-card-name {
            font-family: Georgia, "Times New Roman", serif;
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: -0.04em;
            line-height: 0.95;
        }

        .preview-card-role {
            margin-top: 0.55rem;
            font-size: 0.92rem;
            letter-spacing: 0.28em;
            text-transform: uppercase;
            opacity: 0.64;
        }

        .preview-card-brand {
            font-family: Georgia, "Times New Roman", serif;
            font-size: 1.35rem;
            letter-spacing: -0.04em;
            text-align: right;
        }

        .preview-card-meta {
            font-size: 0.95rem;
            line-height: 1.7;
            opacity: 0.72;
        }

        .preview-card-footer {
            display: flex;
            align-items: end;
            justify-content: space-between;
            gap: 1rem;
        }

        .preview-card-style {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 2rem;
            padding: 0 0.75rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.1);
            font-size: 0.72rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
        }

        @media (max-width: 760px) {
            .product-hero-copy {
                padding-left: 2rem;
            }

            .business-cards-visual {
                width: 100%;
                padding-top: 1.1rem;
            }

            .bc-stack {
                height: 18.5rem;
            }

            .bc-card {
                width: 15.5rem;
                height: 9.2rem;
            }

            .bc-card.dark {
                left: 1.6rem;
            }

            .bc-card.light {
                left: 2.8rem;
                top: 3.9rem;
            }

            .bc-card.green {
                left: 2rem;
                top: 7.6rem;
            }

            .bc-finish-chip {
                min-height: 2.45rem;
                padding: 0 1.1rem;
                font-size: 0.82rem;
            }

            .bc-finish-note {
                font-size: 0.72rem;
                letter-spacing: 0.2em;
            }

            .pricing-section-head {
                margin-bottom: 2rem;
            }

            .preview-layout {
                grid-template-columns: 1fr;
            }

            .detail-with-rail {
                grid-template-columns: 1fr;
                gap: 1.75rem;
            }

            .filters-rail {
                position: static;
            }

            .filters-toggle span {
                font-size: 1.55rem;
            }

            .preview-stage {
                min-height: 28rem;
            }
        }

        /* PRODUCT GRID */
        .scard-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1.5rem;
            margin-top: 1rem;
        }

        .scard {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: var(--r);
            overflow: hidden;
            transition: all 0.25s cubic-bezier(0.1, 0.7, 0.1, 1);
            text-align: center;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            box-shadow: 0 4px 12px rgba(20, 20, 20, 0.02);
        }

        .scard:hover {
            border-color: rgba(20, 20, 20, 0.3);
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(20, 20, 20, 0.08);
        }

        .scard-img {
            width: 100%;
            aspect-ratio: 4/3;
            background: var(--cream-mid);
            object-fit: cover;
            border-bottom: 1px solid var(--border);
            display: block;
        }

        .scard-info {
            padding: 1.4rem 1rem;
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .scard-title {
            font-size: 1.05rem;
            font-weight: 700;
            color: var(--ink);
            margin-bottom: 0.25rem;
            font-family: "Helvetica Neue", Arial, sans-serif;
            letter-spacing: -0.01em;
        }

        .scard-price {
            font-family: "Helvetica Neue", Arial, sans-serif;
            font-size: 0.8rem;
            color: var(--ink-soft);
        }

        @media (max-width: 900px) {
            .scard-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 500px) {
            .scard-grid {
                grid-template-columns: 1fr;
            }
        }
    
        .product-main-override { padding-top: 1rem; padding-bottom: 2rem; max-width: 1440px; margin: 0 auto; }
    </style>
</head>

